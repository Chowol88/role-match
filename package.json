{
    "name": "role-match-cv-tailor",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Privacy-first local web app that evaluates how well a CV matches a job description and proposes grounded, guardrailed tailoring edits.",
    "scripts": {
        "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
        "dev:web": "vite",
        "dev:api": "tsx watch server/index.ts",
        "build": "vite build",
        "test": "vitest --run --config vitest.config.ts",
        "audit": "npm audit",
        "test:watch": "vitest --config vitest.config.ts"
    },
    "license": "UNLICENSED",
    "dependencies": {
        "cors": "^2.8.6",
        "docx": "^9.14.0",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "mammoth": "^1.13.0",
        "multer": "^2.5.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.5",
        "@types/pdfkit": "^0.17.7",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/supertest": "^7.2.1",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "fast-check": "^4.10.2",
        "jsdom": "^30.1.3",
        "selfsigned": "^5.5.0",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vite-plugin-mkcert": "^2.1.0",
        "vitest": "^5.0.5"
    }
}
